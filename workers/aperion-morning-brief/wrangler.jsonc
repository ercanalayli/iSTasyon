{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aperion-morning-brief",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "triggers": {
    "crons": ["0 6 * * *", "5 6 * * *"]
  },
  "vars": {
    "BRIEF_DISPATCH_URL": "https://aperion-istasyon.pages.dev/api/morning-brief-dispatch",
    "E2E_DISPATCH_URL": "https://aperion-istasyon.pages.dev/api/daily-e2e-check"
  },
  "d1_databases": [
    {
      "binding": "APERION_DB",
      "database_name": "aperion-control-plane",
      "database_id": "8f32b3b1-5451-4c9e-9bd2-5d3626e4a561",
      "migrations_dir": "../../migrations"
    }
  ]
}
